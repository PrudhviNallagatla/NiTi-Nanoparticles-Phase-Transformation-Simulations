# filepath: /home/rimuru/workspace/src/lmps/se.lmp
# GOAL: NiTi Nanoparticle Superelasticity (Isothermal Loading > Af)
# REVISION: v1 (Restart-Proof Reference States)

clear
units       metal
dimension   3
# [PHYSICS] Shrink-wrap 's' allows box to follow particle, 
# but we center it first to avoid wall issues.
boundary    s s s
atom_style  atomic

# --- VARIABLES & INPUTS ---
if "$(is_defined(input_data)) == 0"     then "variable input_data string 'minimized.data'"
if "$(is_defined(restart_file)) == 0"   then "variable restart_file string 'none'"
if "$(is_defined(output_dir)) == 0"     then "variable output_dir string 'se_output'"
if "$(is_defined(restart_dir)) == 0"    then "variable restart_dir string 'restarts'"
if "$(is_defined(pot_lib)) == 0"        then "variable pot_lib string 'library.meam'"
if "$(is_defined(pot_file)) == 0"       then "variable pot_file string 'NiTi.meam'"

shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# --- INITIALIZATION ---
if "${restart_file} == none" then "read_data ${input_data}"
if "${restart_file} != none" then "read_restart ${restart_file}"

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin
neigh_modify delay 10 every 1 check yes

comm_style tiled
fix bal all balance 5000 1.05 rcb

timestep    0.002

# --- PROTOCOL PARAMETERS ---
# [CRITICAL] T_se must be > Af (Austenite Finish Temp) for Superelasticity
variable T_se       equal 500.0   
variable tdamp      equal 100.0*dt

# Mechanical Loading (Compression)
variable strain_max equal 0.10      # 10% Strain
variable load_time  equal 2000.0    # ps
variable load_steps equal round(v_load_time/dt)
variable unload_time equal 2000.0
variable unload_steps equal round(v_unload_time/dt)

variable eq_steps   equal 30000
variable hold_steps equal 20000

# Stage End Steps (Absolute)
variable end0 equal ${eq_steps}
variable end1 equal ${end0}+${load_steps}
variable end2 equal ${end1}+${unload_steps}
variable end3 equal ${end2}+${hold_steps}

# --- PERSISTENCE LOGIC (The Fix) ---
variable param_file string "${output_dir}/se_ref.lmp"

# Default values (overwritten if file exists)
variable Lz_ref equal 0.0
variable z_hi0  equal 0.0
variable z_lo0  equal 0.0

# Load params if restart
if "$(is_file(v_param_file))" then "include ${param_file}"

# --- COMPUTES ---
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
variable R_eff equal sqrt(c_r2max)
variable V_eff equal (4.0/3.0)*PI*(v_R_eff^3)

# Core Identification
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core dynamic all var core_mask every 1000

compute T_core core temp

# Stress & Phase
compute pe_atom all pe/atom
compute csym all centro/atom bcc
compute ack  all ackland/atom
compute st   all stress/atom NULL
compute Szz all reduce sum c_st[3]

# Stress in GPa (Virial / Effective Volume)
variable sigma_zz_GPa equal -(c_Szz/(v_V_eff+1.0e-12))*1.0e-4

# Geometry & Strain
compute zmin all reduce min z
compute zmax all reduce max z
variable Lz equal (c_zmax - c_zmin)

# Robust Strain Calc
variable strain equal "(v_Lz_ref > 0) * (v_Lz - v_Lz_ref)/(v_Lz_ref+1.0e-12)"

# --- EXECUTION ---

if "$(step) == 0" then "velocity all create ${T_se} 88421 mom yes rot yes dist gaussian"
fix mom all momentum 100 linear 1 1 1 angular

# Outputs
variable restart_every equal 10000
restart ${restart_every} ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

thermo 1000
thermo_style custom step temp c_T_core v_sigma_zz_GPa v_strain v_R_eff

fix out all print 500 &
"$(step) $(time) $(temp) $(c_T_core) $(v_Lz) $(v_strain) $(v_sigma_zz_GPa)" &
file ${output_dir}/se_scalar.txt append yes screen no &
title "# step time_ps T Tcore Lz strain sigmaZZ_GPa"

dump 1 all custom 5000 ${output_dir}/dump.se.*.gz id type x y z c_ack c_st[3]
dump_modify 1 sort id element Ni Ti

print ">>> STARTING SUPERELASTICITY PROTOCOL..."

# --- STAGE 0: EQUILIBRATION ---
if "$(step) < ${end0}" then &
  "print '>>> STAGE 0: Equilibrating Austenite at ${T_se} K'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "run ${end0} upto" &
  "unfix nvt" &
  "write_restart ${output_dir}/restart.se_stage0_end"

# --- CAPTURE REFERENCE STATE ---
# Only execute if we are at the transition point
if "$(step) == ${end0}" then &
  "run 0" &
  "variable current_Lz equal ${Lz}" &
  "variable current_zhi equal c_zmax" &
  "variable current_zlo equal c_zmin" &
  "print '# Reference Parameters for SE Loading' file ${param_file}" &
  "print 'variable Lz_ref equal ${current_Lz}' append ${param_file}" &
  "print 'variable z_hi0  equal ${current_zhi}' append ${param_file}" &
  "print 'variable z_lo0  equal ${current_zlo}' append ${param_file}" &
  "print '>>> REFERENCE STATE SAVED to ${param_file}'" &
  "include ${param_file}"

# --- STAGE 1: LOADING (COMPRESSION) ---
if "$(step) < ${end1}" then &
  "print '>>> STAGE 1: Loading (Compression)'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "variable start_step equal ${end0}" &
  "variable ramp equal (step - v_start_step)/${load_steps}" &
  "variable ramp_safe equal (step > (v_start_step + ${load_steps})) ? 1.0 : v_ramp" &
  "variable pos_hi equal v_z_hi0 - (${Lz_ref}*${strain_max}*0.5*v_ramp_safe)" &
  "variable pos_lo equal v_z_lo0 + (${Lz_ref}*${strain_max}*0.5*v_ramp_safe)" &
  "fix wall_hi all wall/harmonic zhi v_pos_hi 100.0 0.0 2.5 units box" &
  "fix wall_lo all wall/harmonic zlo v_pos_lo 100.0 0.0 2.5 units box" &
  "run ${end1} upto" &
  "unfix wall_hi" &
  "unfix wall_lo" &
  "unfix nvt" &
  "write_restart ${output_dir}/restart.se_stage1_end"

# --- STAGE 2: UNLOADING (RELAXATION) ---
if "$(step) < ${end2}" then &
  "print '>>> STAGE 2: Unloading'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "variable start_step equal ${end1}" &
  "variable ramp equal (step - v_start_step)/${unload_steps}" &
  "variable ramp_safe equal (step > (v_start_step + ${unload_steps})) ? 1.0 : v_ramp" &
  # Reverse the wall motion: (1.0 - ramp)
  "variable pos_hi equal v_z_hi0 - (${Lz_ref}*${strain_max}*0.5*(1.0-v_ramp_safe))" &
  "variable pos_lo equal v_z_lo0 + (${Lz_ref}*${strain_max}*0.5*(1.0-v_ramp_safe))" &
  "fix wall_hi all wall/harmonic zhi v_pos_hi 100.0 0.0 2.5 units box" &
  "fix wall_lo all wall/harmonic zlo v_pos_lo 100.0 0.0 2.5 units box" &
  "run ${end2} upto" &
  "unfix wall_hi" &
  "unfix wall_lo" &
  "unfix nvt" &
  "write_restart ${output_dir}/restart.se_stage2_end"

# --- STAGE 3: FINAL HOLD (RESIDUAL STRAIN CHECK) ---
if "$(step) < ${end3}" then &
  "print '>>> STAGE 3: Final Hold (Checking Recovery)'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "run ${end3} upto" &
  "unfix nvt" &
  "write_restart ${output_dir}/restart.se_stage3_end"

print "SE PROTOCOL COMPLETE."