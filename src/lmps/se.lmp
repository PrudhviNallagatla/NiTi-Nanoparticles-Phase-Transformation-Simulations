# filepath: /home/rimuru/workspace/src/lmps/se_journal_v2.lmp
# GOAL: Journal-Grade NiTi Nanoparticle Superelasticity (Isothermal Loading > Af)
# REVISION: v2 (Integrated Physics + CPU Tracking + Enthalpy + Crash-Proofing)

clear
units       metal
dimension   3
# [SAFETY] Shrink-wrap 's' allows box to follow particle.
# We center it initially to avoid wall interaction issues.
boundary    s s s
atom_style  atomic

# ==========================================================================
# 1. ENVIRONMENT & VARIABLES
# ==========================================================================
variable input_data    getenv INPUT_DATA
variable restart_file  getenv RESTART_FILE
variable output_dir    getenv OUTPUT_DIR
variable restart_dir   getenv RESTART_DIR
variable pot_lib       getenv POT_LIB
variable pot_file      getenv POT_FILE
variable seed          getenv SEED

# Restart cadence
variable restart_every equal 10000

shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# --- INITIALIZATION ---
if "${restart_file} == none" then "read_data ${input_data}"
if "${restart_file} != none" then "read_restart ${restart_file}"

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin
neigh_modify delay 10 every 1 check yes

comm_style tiled
fix bal all balance 5000 1.05 rcb

timestep    0.002

# ==========================================================================
# 2. PROTOCOL & PHYSICS
# ==========================================================================
# [CRITICAL] T_se must be > Af (Austenite Finish Temp) for Superelasticity
variable T_se       equal 500.0   
variable tdamp      equal 100.0*dt

# --- Mechanical Loading (Compression) ---
variable strain_max equal 0.10      # 10% Strain
variable load_time  equal 2000.0    # ps
variable load_steps equal round(v_load_time/dt)
variable unload_time equal 2000.0
variable unload_steps equal round(v_unload_time/dt)

variable eq_steps   equal 30000
variable hold_steps equal 20000

# --- Stage End Steps (Absolute) ---
variable end0 equal ${eq_steps}
variable end1 equal ${end0}+${load_steps}
variable end2 equal ${end1}+${unload_steps}
variable end3 equal ${end2}+${hold_steps}

# --- RESTART-PROOF REFERENCE LOGIC ---
variable param_file string "${output_dir}/se_ref.lmp"
# Default values (overwritten if se_ref.lmp contains saved values)
variable Lz_ref equal 0.0
variable z_hi0  equal 0.0
variable z_lo0  equal 0.0
# Ensure file exists
shell touch "${param_file}"
include ${param_file}

# ==========================================================================
# 3. ADVANCED COMPUTATIONS (Journal-Grade)
# ==========================================================================

# --- A. Time & Cost ---
variable t_elapsed internal elapsed
variable cpu_hours equal v_t_elapsed/3600.0

# --- B. Core/Surface & Geometry ---
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
# Global Effective Volume (Safe approximation for Stress Calculation)
variable Vol_total equal (4.0/3.0)*PI*(c_r2max^1.5)

# Core Group Definition
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core dynamic all var core_mask every 1000

# --- C. Thermodynamics (Enthalpy) ---
compute T_core core temp
compute pe_atom all pe/atom
compute ke_atom all ke/atom

# Enthalpy (H = PE + KE). PV ~ 0 for vacuum.
compute H_all all reduce sum c_pe_atom c_ke_atom
variable H_total_eV equal c_H_all[1]+c_H_all[2]

# --- D. Crystallography & Phase ---
compute csym all centro/atom bcc
compute ack  all ackland/atom
compute cna  all cna/atom 3.0

# Phase Fraction (Austenite Proxy: Ackland == 3)
variable is_austenite atom "c_ack == 3"
compute n_aus core reduce sum v_is_austenite
variable n_core   equal "count(core)"
variable frac_aus equal "c_n_aus/(v_n_core+1.0e-6)"

# --- E. Mechanical Stress (Tensor) ---
compute st all stress/atom NULL

# Global Stress (Virial / Effective Volume) - GPa
compute Szz all reduce sum c_st[3]
variable sigma_zz_GPa equal -(c_Szz/(v_Vol_total+1.0e-12))*1.0e-4

# Local Stress Metrics (for Dump)
# Von Mises & Pressure (Qualitative per atom without Voronoi volume)
variable vm_atom atom sqrt(0.5*((c_st[1]-c_st[2])^2+(c_st[2]-c_st[3])^2+(c_st[3]-c_st[1])^2+6*(c_st[4]^2+c_st[5]^2+c_st[6]^2)))
variable p_atom  atom -(c_st[1]+c_st[2]+c_st[3])/3.0

# --- F. Strain & Shape ---
compute gyr all gyration
variable Rg    equal c_gyr

compute zmin all reduce min z
compute zmax all reduce max z
variable Lz equal (c_zmax - c_zmin)

# Strain Calculation (Restart-Safe)
variable strain equal "(v_Lz_ref > 0) * (v_Lz - v_Lz_ref)/(v_Lz_ref+1.0e-12)"

# Displacement (Transformation Vector)
compute disp all displace/atom
variable disp_mag atom sqrt(c_disp[1]^2+c_disp[2]^2+c_disp[3]^2)
compute disp_rms all reduce ave v_disp_mag

# ==========================================================================
# 4. OUTPUTS (Clean Terminal / Rich Files)
# ==========================================================================

# 4.1. Terminal (6 Vital Signs)
thermo 1000
thermo_style custom step v_cpu_hours temp c_T_core v_strain v_sigma_zz_GPa

# 4.2. Detailed Log (The Vault)
fix out all print 500 &
"$(step) $(v_cpu_hours) $(temp) $(c_T_core) $(v_Lz) $(v_strain) $(v_sigma_zz_GPa) $(v_frac_aus) $(v_H_total_eV) $(c_disp_rms)" &
file ${output_dir}/se_data.txt append yes screen no &
title "# Step CPU_Hrs T_Global T_Core Lz Strain SigmaZZ(GPa) Frac_Aus H_Total(eV) Disp_RMS(A)"

# 4.3. Rich Dump (Visualization)
dump 1 all custom 5000 ${output_dir}/dump.se.*.gz &
    id type x y z &
    c_pe_atom c_csym c_ack c_cna &
    c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6] &
    v_vm_atom v_p_atom &
    c_disp[1] c_disp[2] c_disp[3]
dump_modify 1 sort id element Ni Ti

restart ${restart_every} ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

# ==========================================================================
# 5. EXECUTION
# ==========================================================================

if "$(step) == 0" then "velocity all create ${T_se} ${seed} mom yes rot yes dist gaussian"
fix mom all momentum 100 linear 1 1 1 angular

print ">>> STARTING SUPERELASTICITY PROTOCOL..."

# --- STAGE 0: EQUILIBRATION ---
if "$(step) < ${end0}" then &
  "print '>>> STAGE 0: Equilibrating Austenite at ${T_se} K'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "run ${end0} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.se_stage0_end"

# --- CAPTURE REFERENCE STATE ---
# Only execute if we are at the transition point
if "$(step) == ${end0}" then &
  "run 0" &
  "variable current_Lz  equal v_Lz" &
  "variable current_zhi equal c_zmax" &
  "variable current_zlo equal c_zmin" &
  "print '# Reference Parameters for SE Loading' file ${param_file}" &
  "print 'variable Lz_ref equal ${current_Lz}' append ${param_file}" &
  "print 'variable z_hi0  equal ${current_zhi}' append ${param_file}" &
  "print 'variable z_lo0  equal ${current_zlo}' append ${param_file}" &
  "print '>>> REFERENCE STATE SAVED to ${param_file}'" &
  "include ${param_file}"

# --- STAGE 1: LOADING (COMPRESSION) ---
if "$(step) < ${end1}" then &
  "print '>>> STAGE 1: Loading (Compression)'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "variable start_step equal ${end0}" &
  "variable ramp equal (step - v_start_step)/${load_steps}" &
  "variable ramp_safe equal (step > (v_start_step + ${load_steps})) ? 1.0 : v_ramp" &
  "variable pos_hi equal v_z_hi0 - (v_Lz_ref*${strain_max}*0.5*v_ramp_safe)" &
  "variable pos_lo equal v_z_lo0 + (v_Lz_ref*${strain_max}*0.5*v_ramp_safe)" &
  "fix wall_hi all wall/harmonic zhi v_pos_hi 100.0 0.0 2.5 units box" &
  "fix wall_lo all wall/harmonic zlo v_pos_lo 100.0 0.0 2.5 units box" &
  "run ${end1} upto" &
  "unfix wall_hi" &
  "unfix wall_lo" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.se_stage1_end"

# --- STAGE 2: UNLOADING (RELAXATION) ---
if "$(step) < ${end2}" then &
  "print '>>> STAGE 2: Unloading'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "variable start_step equal ${end1}" &
  "variable ramp equal (step - v_start_step)/${unload_steps}" &
  "variable ramp_safe equal (step > (v_start_step + ${unload_steps})) ? 1.0 : v_ramp" &
  "variable pos_hi equal v_z_hi0 - (v_Lz_ref*${strain_max}*0.5*(1.0-v_ramp_safe))" &
  "variable pos_lo equal v_z_lo0 + (v_Lz_ref*${strain_max}*0.5*(1.0-v_ramp_safe))" &
  "fix wall_hi all wall/harmonic zhi v_pos_hi 100.0 0.0 2.5 units box" &
  "fix wall_lo all wall/harmonic zlo v_pos_lo 100.0 0.0 2.5 units box" &
  "run ${end2} upto" &
  "unfix wall_hi" &
  "unfix wall_lo" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.se_stage2_end"

# --- STAGE 3: FINAL HOLD (RESIDUAL STRAIN CHECK) ---
if "$(step) < ${end3}" then &
  "print '>>> STAGE 3: Final Hold (Checking Recovery)'" &
  "fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}" &
  "run ${end3} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.se_stage3_end" &
  "write_data ${output_dir}/final.data"

print "SE PROTOCOL COMPLETE. TOTAL CPU: ${cpu_hours} HRS"