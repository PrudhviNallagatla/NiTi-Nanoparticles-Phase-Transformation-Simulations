# ====================================================================
#  SUPERELASTICITY SIMULATION FOR NiTi NANOPARTICLES
#  Purpose: Measure stress-strain hysteresis during mechanical cycling
#  Physics: Load → Unload at constant high temperature (austenite phase)
#  Key Output: Stress vs strain curve showing elastic recovery
# ====================================================================

clear
units       metal          # eV, Å, ps, K
dimension   3
boundary    s s s          # Shrink-wrapped (non-periodic)
atom_style  atomic

# ==========================================================================
# 1. ENVIRONMENT VARIABLES & FILE PATHS
# ==========================================================================
variable output_dir    getenv OUTPUT_DIR       # Results directory
variable restart_dir   getenv RESTART_DIR      # Checkpoint storage
variable pot_lib       getenv POT_LIB          # MEAM library file
variable pot_file      getenv POT_FILE         # MEAM parameters
variable thermal_file  getenv THERMAL_RESTART  # Pre-equilibrated structure from thermal cycle

shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# Remove stale reference file from any previous failed runs
variable param_file string "${output_dir}/se_ref.lmp"
shell rm -f ${param_file}

print ">>> STARTING SUPERELASTICITY SIMULATION"
print ">>> Loading Thermal History: ${thermal_file}"

# Load pre-equilibrated structure (already at desired temperature)
read_restart ${thermal_file}
reset_timestep 0

# --- INTERATOMIC POTENTIAL (Ni-Ti MEAM) ---
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin                    # Neighbor list cutoff buffer
neigh_modify delay 10 every 1 check yes

comm_style tiled                       # Efficient parallel decomposition
fix bal all balance 5000 1.05 rcb     # Dynamic load balancing

timestep    0.002                      # 2 fs integration timestep

# ==========================================================================
# 2. STRUCTURAL & THERMODYNAMIC DIAGNOSTICS
# ==========================================================================

# --- A. GEOMETRY: Define particle core vs surface ---
compute com all com                    # Center of mass
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2  # Radial distance²
compute r2max all reduce max v_rsq                      # Find particle radius²
variable Vol_total equal (4.0/3.0)*PI*(c_r2max^1.5)    # Spherical volume estimate

# Core = inner 80% by volume (r² < 0.64*r²_max)
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core dynamic all var core_mask every 1000         # Update group membership

# --- B. TEMPERATURE & ENERGY ---
compute T_core core temp               # Core temperature (excludes surface effects)
compute pe_atom all pe/atom            # Per-atom potential energy
compute ke_atom all ke/atom            # Per-atom kinetic energy

# Total enthalpy (thermodynamic state function)
compute H_all all reduce sum c_pe_atom c_ke_atom
variable H_total_eV equal c_H_all[1]+c_H_all[2]

# --- C. CRYSTALLOGRAPHIC PHASE IDENTIFICATION ---
compute csym all centro/atom bcc       # Centrosymmetry parameter (defect detection)
compute ack  all ackland/atom          # Ackland structure analysis (BCC=3, FCC=1)
compute cna  all cna/atom 3.0          # Common neighbor analysis

# Calculate austenite (BCC) fraction in core
variable is_austenite atom "c_ack == 3"
compute n_aus core reduce sum v_is_austenite
variable n_core    equal "count(core)"
variable frac_aus equal "c_n_aus/(v_n_core+1.0e-6)"  # Avoid division by zero

# --- D. STRESS STATE ---
compute st all stress/atom NULL        # Per-atom stress tensor (Voigt notation)
compute Szz all reduce sum c_st[3]     # Total axial stress component
variable sigma_zz_GPa equal -(c_Szz/(v_Vol_total+1.0e-12))*1.0e-4  # Convert to GPa

# von Mises stress (scalar measure of shear)
variable vm_atom atom sqrt(0.5*((c_st[1]-c_st[2])^2+(c_st[2]-c_st[3])^2+(c_st[3]-c_st[1])^2+6*(c_st[4]^2+c_st[5]^2+c_st[6]^2)))
# Hydrostatic pressure
variable p_atom  atom -(c_st[1]+c_st[2]+c_st[3])/3.0

# --- E. STRAIN MEASUREMENT ---
compute zmin all reduce min z          # Particle bottom boundary
compute zmax all reduce max z          # Particle top boundary
variable Lz equal c_zmax-c_zmin        # Current axial length

# Reference state (will be captured after equilibration)
variable Lz_ref equal 0.0              # Initial length
variable z_hi0  equal 0.0              # Initial top boundary
variable z_lo0  equal 0.0              # Initial bottom boundary

# Engineering strain = (L - L₀) / L₀
variable strain equal (v_Lz_ref>0)*(v_Lz-v_Lz_ref)/(v_Lz_ref+1.0e-12)

# --- F. ATOMIC DISPLACEMENT (Shape Memory Effect Metric) ---
compute disp all displace/atom         # Displacement from initial positions
variable disp_mag atom sqrt(c_disp[1]^2+c_disp[2]^2+c_disp[3]^2)
compute disp_rms all reduce ave v_disp_mag  # RMS displacement

# ==========================================================================
# 3. OUTPUT CONFIGURATION
# ==========================================================================
variable t_cpu      equal cpu          # Wall clock time in seconds
variable cpu_hours  equal v_t_cpu/3600.0

thermo 1000                            # Print to screen every 1000 steps
thermo_style custom step temp c_T_core v_strain v_sigma_zz_GPa v_frac_aus v_cpu_hours

# Write detailed data to file every 500 steps
fix out all print 500 &
"$(step) $(temp) $(c_T_core) $(v_Lz) $(v_strain) $(v_sigma_zz_GPa) $(v_frac_aus) $(v_H_total_eV) $(c_disp_rms) $(v_cpu_hours)" &
file ${output_dir}/se_data.txt screen no &
title "# Step T_Global T_Core Lz Strain SigmaZZ(GPa) Frac_Aus H_Total(eV) Disp_RMS(A) CPU_Hrs"

# Full atomic trajectory every 5000 steps (10 ps intervals)
dump 1 all custom 5000 ${output_dir}/dump.se.*.gz &
    id type x y z &
    c_pe_atom c_csym c_ack c_cna &
    c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6] &
    v_vm_atom v_p_atom &
    c_disp[1] c_disp[2] c_disp[3]
dump_modify 1 sort id element Ni Ti

# Alternating restart files for crash recovery
restart 10000 ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

# ==========================================================================
# 4. MECHANICAL TESTING PROTOCOL
# ==========================================================================
variable T_se       equal 500.0        # Test temperature (K) - austenite stable
variable tdamp      equal 100.0*dt     # Nose-Hoover thermostat damping (0.2 ps)
variable strain_max equal 0.10         # Maximum compression (10%)
variable load_time  equal 2000.0       # Loading duration (ps)
variable unload_time equal 2000.0      # Unloading duration (ps)
variable hold_time  equal 500.0        # Not used in this version

# Convert times to simulation steps
variable load_steps    equal round(v_load_time/dt)
variable unload_steps equal round(v_unload_time/dt)
variable hold_steps    equal round(v_hold_time/dt)
variable eq_steps      equal 1000      # Initial equilibration

# Calculate absolute timestep milestones
variable end0_abs equal v_eq_steps
variable end1_abs equal v_end0_abs+v_load_steps
variable end2_abs equal v_end1_abs+v_unload_steps

# Remove center-of-mass drift
fix mom all momentum 100 linear 1 1 1 angular

# ==========================================================================
# STAGE 0: EQUILIBRATION
# Purpose: Stabilize structure at test temperature before loading
# ==========================================================================
print ">>> STAGE 0: Equilibrating at ${T_se} K"
fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}
run ${end0_abs} upto
unfix nvt
write_restart ${restart_dir}/restart.se_stage0_end

# ==========================================================================
# CAPTURE REFERENCE STATE
# Purpose: Define strain=0 configuration after equilibration
# ==========================================================================
variable current_Lz  equal v_Lz
variable current_zhi equal c_zmax
variable current_zlo equal c_zmin

# Overwrite reference variables
variable Lz_ref delete
variable z_hi0  delete
variable z_lo0  delete
variable Lz_ref equal ${current_Lz}
variable z_hi0  equal ${current_zhi}
variable z_lo0  equal ${current_zlo}

# Save to file for potential restart
print "# Reference Params" file ${param_file}
print "variable Lz_ref equal ${current_Lz}" append ${param_file}
print "variable z_hi0  equal ${current_zhi}" append ${param_file}
print "variable z_lo0  equal ${current_zlo}" append ${param_file}
print ">>> REFERENCE STATE CAPTURED: Lz=${Lz_ref} Å"

# ==========================================================================
# STAGE 1: LOADING (COMPRESSION)
# Purpose: Apply uniaxial compression to induce stress-induced transformation
# Method: Moving harmonic walls with buffer zone to prevent edge artifacts
# ==========================================================================
print ">>> STAGE 1: Loading (compression with buffer)"
fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}

# --- WALL MOTION LOGIC ---
variable buffer equal 5.0              # Buffer distance (Å) beyond particle surface
variable ramp_load  equal (step-v_end0_abs)/${load_steps}  # Linear ramp [0,1]

# Calculate distances
variable compress_dist equal (v_Lz_ref*${strain_max}*0.5)  # Half-compression per side
variable travel_dist   equal (v_buffer+v_compress_dist)    # Total wall travel

# Wall positions: Start at (surface + buffer), move to (surface - compression)
variable pos_hi_load equal (v_z_hi0+v_buffer)-(v_travel_dist*v_ramp_load)
variable pos_lo_load equal (v_z_lo0-v_buffer)+(v_travel_dist*v_ramp_load)

# Harmonic walls: K=1000 eV/Å², cutoff=2.5Å
fix wall_hi all wall/harmonic zhi v_pos_hi_load 1000.0 0.0 2.5 units box
fix wall_lo all wall/harmonic zlo v_pos_lo_load 1000.0 0.0 2.5 units box

run ${end1_abs} upto
unfix wall_hi
unfix wall_lo
unfix nvt
write_restart ${restart_dir}/restart.se_stage1_end

# ==========================================================================
# STAGE 2: UNLOADING (ELASTIC RECOVERY)
# Purpose: Remove load to observe shape recovery via reverse transformation
# Method: Reverse wall motion back to buffered reference position
# ==========================================================================
print ">>> STAGE 2: Unloading (elastic recovery)"
fix nvt all nvt temp ${T_se} ${T_se} ${tdamp}

variable ramp_unload equal (step-v_end1_abs)/${unload_steps}  # Linear ramp [0,1]

# Reverse motion: Start at compressed state, return to (surface + buffer)
variable pos_hi_unload equal (v_z_hi0-v_compress_dist)+(v_travel_dist*v_ramp_unload)
variable pos_lo_unload equal (v_z_lo0+v_compress_dist)-(v_travel_dist*v_ramp_unload)

fix wall_hi all wall/harmonic zhi v_pos_hi_unload 1000.0 0.0 2.5 units box
fix wall_lo all wall/harmonic zlo v_pos_lo_unload 1000.0 0.0 2.5 units box

run ${end2_abs} upto
unfix wall_hi
unfix wall_lo
unfix nvt
write_restart ${restart_dir}/restart.se_stage2_end

# ==========================================================================
# FINALIZATION
# ==========================================================================
print ">>> SUPERELASTICITY TEST COMPLETE"
write_data ${output_dir}/final.data nocoeff