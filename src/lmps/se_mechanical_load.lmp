# GOAL: Superelasticity of 10nm NiTi Nanoparticle (Grip Method)
# SYSTEM: Single Crystal Nanoparticle (Austenite Start)

clear
units       metal
dimension   3
boundary    s s s
atom_style  atomic

read_data   ${input_data}

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    1.0 bin
neigh_modify delay 0 every 1 check yes

# Load Balancing (Speedup)
fix bal all balance 1000 1.05 shift x y z

# ============================================
# 1. PHYSICS SETUP
# ============================================

# TEMPERATURE: Must be > Af (e.g., 450K or 500K depending on your cycle results)
variable test_temp equal 450.0 
variable tdamp     equal 100.0*dt

# STRAIN PARAMETERS
# Rate: 1e-4 /ps (Faster than experiment, standard for MD)
# Max Strain: 8% (0.08)
variable strain_rate equal 1.0e-4 
variable max_strain  equal 0.08

timestep    0.002

# ============================================
# 2. DEFINE GRIPS (The Physical Pullers)
# ============================================
# We freeze the ends of the particle to act as clamps
variable x_min equal bound(all,xmin)
variable x_max equal bound(all,xmax)
variable L0    equal v_x_max-v_x_min

# Grips are the outer 10 Angstroms on X-axis
region r_anchor block INF $(v_x_min+10.0) INF INF INF INF units box
region r_pull   block $(v_x_max-10.0) INF INF INF INF INF units box

group anchor region r_anchor
group pull   region r_pull
group mobile subtract all anchor pull

# Color grips for visualization
group Ni type 1
group Ti type 2
color anchor red
color pull   blue

# ============================================
# 3. COMPUTATIONS (stress via grip reaction force)
# ============================================

# (Keep your existing csym/pe if you want)
compute csym all centro/atom bcc
compute pe_atom all pe/atom

# --- Initial geometry references (after run 0) ---
variable y_min equal bound(all,ymin)
variable y_max equal bound(all,ymax)
variable z_min equal bound(all,zmin)
variable z_max equal bound(all,zmax)

run 0
variable A0 equal "(${y_max}-${y_min})*(${z_max}-${z_min})"   # Å^2 (simple bbox estimate)

# --- Reaction force on the pull grip (sum of Fx on pull atoms) ---
compute Fx_pull pull reduce sum fx

# Engineering stress (GPa): (eV/Å) / Å^2 = eV/Å^3, then *160.217
# Negative sign makes tensile typically positive (verify with your convention)
variable stress_GPa equal "-(c_Fx_pull / v_A0) * 160.217"

# STRAIN (Based on Grip Distance)
# We track the Center of Mass of the Pull group relative to Anchor
variable x_anchor equal xcm(anchor,x)
variable x_pull   equal xcm(pull,x)
variable L_current equal "v_x_pull - v_x_anchor"

# Capture initial length
run 0
variable L_ref equal ${L_current}
variable strain equal "(v_L_current - v_L_ref) / v_L_ref"

# ============================================
# 4. EQUILIBRATION (Austenite)
# ============================================
print "=== EQUILIBRATING AUSTENITE ==="
velocity all create ${test_temp} 48274 dist gaussian

# Hold anchor, thermostat mobile atoms
fix 1 mobile nvt temp ${test_temp} ${test_temp} ${tdamp}
fix 2 anchor setforce 0.0 0.0 0.0
velocity anchor set 0 0 0

# Allow pull group to relax thermally but keep average pos? 
# Actually, for tensile, best to thermostat everything first.
fix 3 pull nvt temp ${test_temp} ${test_temp} ${tdamp}
run 20000

unfix 3 # Release pull group for mechanical driving

# ============================================
# 5. LOADING (Tensile Pull)
# ============================================
print "=== LOADING START ==="

# Calculate Velocity required: v = L0 * rate
variable pull_vel equal v_L_ref*v_strain_rate
variable run_time equal v_max_strain/v_strain_rate
variable run_steps equal round(v_run_time/dt)

print "Pull Velocity: ${pull_vel} A/ps"
print "Duration: ${run_steps} steps"

# 1. Anchor stays fixed
# 2. Mobile atoms are thermostatted (remove heat of transformation)
# 3. Pull group moves at constant velocity
fix 3 pull move linear ${pull_vel} 0.0 0.0 units box

# Output
fix data_out all print 500 &
    "$(step) $(temp) $(v_strain) $(v_stress_GPa)" &
    file ${output_dir}/stress_strain_se.txt screen no &
    title "# Step Temp Strain Stress_GPa"

dump 1 all custom 5000 ${output_dir}/se_*.dump id type x y z c_csym c_pe_atom
dump_modify 1 sort id

run ${run_steps}

# ============================================
# 6. UNLOADING (Superelastic Recovery)
# ============================================
print "=== UNLOADING START ==="

# To simulate "unloading", we remove the drive and let the spring (SE) pull back.
# However, we must control the return to prevent violent snapping.
# Option A: Reverse velocity (Displacement Control Unloading) - SAFER
# Option B: Release force (Force Control) - HARDER in MD

# We use Option A: Reverse the pull velocity
unfix 3
fix 3 pull move linear -${pull_vel} 0.0 0.0 units box

run ${run_steps}

# ============================================
# 7. FINAL RELAXATION
# ============================================
print "=== HOLDING ZERO STRAIN ==="
unfix 3
# Now let Pull group relax naturally (thermostatted)
fix 3 pull nvt temp ${test_temp} ${test_temp} ${tdamp}
run 20000

print "SIMULATION COMPLETE"