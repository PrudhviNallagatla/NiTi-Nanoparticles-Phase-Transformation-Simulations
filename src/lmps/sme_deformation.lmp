# ==========================================================================
# GOAL: Robust 10nm+ NiTi Compression (Shape Memory Effect)
# SYSTEM: Single Crystal Nanoparticle (B2 Start)
# ==========================================================================

clear
units       metal
dimension   3
boundary    s s s
atom_style  atomic

# --- INPUT VARIABLES (From Shell Script) ---
variable input_data string "niti_10nm_B2.data"  # Default for testing
variable pot_lib    string "library.meam"
variable pot_file   string "NiTi.meam"
variable output_dir string "output_deform"

# --- SETUP ---
read_data   ${input_data}
shell       mkdir ${output_dir}

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    1.0 bin
neigh_modify delay 0 every 1 check yes
timestep    0.002

# ============================================
# 1. CORE DEFINITION (CRITICAL FOR NANOPARTICLES)
# ============================================
# Compute center of mass once
compute com_x all reduce ave x
compute com_y all reduce ave y
compute com_z all reduce ave z
variable xcm equal c_com_x
variable ycm equal c_com_y
variable zcm equal c_com_z

# Compute bounds for radius
compute xmin_all all reduce min x
compute xmax_all all reduce max x
variable x_span equal c_xmax_all-c_xmin_all

# Define radial distance variable
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2

# Exclude outer shell (approx 40% radius from center)
variable rcut equal 0.4*v_x_span 
variable rcut_sq equal v_rcut*v_rcut
group core dynamic all var rsq every 1000

# Alternative static group definition (more stable):
# run 0
# variable rcut_val equal 0.4*v_x_span
# group core variable rsq < v_rcut_val*v_rcut_val
group surface subtract all core

# ============================================
# 2. VARIABLES & METRICS
# ============================================

# Thermal Targets
variable    T_low   equal 200.0   # Martensite State
variable    T_high  equal 450.0   # Austenite State
variable    tdamp   equal 100.0*dt

# Mechanical Targets
variable    strain_max  equal 0.10   # 10% Strain (Aim for 8-12%)
variable    load_time   equal 2000.0 # 2 ns (Good speed)
variable    load_steps  equal ${load_time}/dt

# --- PHYSICS COMPUTATIONS ---
compute T_core core temp
compute pe_atom all pe/atom

# Phase ID (Using BCC centrosymmetry with 8 neighbors)
compute csym all centro/atom bcc
variable CSP_CUTOFF equal 1.5
variable is_martensite atom "c_csym > v_CSP_CUTOFF"

# Count Martensite ONLY in the Core
compute n_mart core reduce sum v_is_martensite
variable n_core equal count(core)
variable frac_mart equal "c_n_mart / (v_n_core + 1.0e-6)"

# STRESS COMPUTATION (Virial / Particle Volume)
variable Vol_Particle equal count(core)*11.0 
compute peratom_stress core stress/atom NULL
compute p_core core reduce sum c_peratom_stress[3]
variable stress_GPa equal "(c_p_core / v_Vol_Particle) * 160.217"

# --- GEOMETRY ---
# Use compute reduce for bounds
compute zmin_comp all reduce min z
compute zmax_comp all reduce max z

# Capture initial dimensions
run 0
variable z_min_0 equal c_zmin_comp
variable z_max_0 equal c_zmax_comp
variable Lz_0    equal v_z_max_0-v_z_min_0

# Strain Variable (updated dynamically)
variable current_Lz equal c_zmax_comp-c_zmin_comp
variable true_strain equal "(v_Lz_0 - v_current_Lz) / v_Lz_0"

# ============================================
# 3. PROTOCOL: THERMAL PREP
# ============================================
print "=== STEP 1: INITIALIZATION ==="
velocity all create ${T_high} 48274 dist gaussian
fix freeze_mom all momentum 1000 linear 1 1 1 angular

print "=== STEP 2: COOLING TO MARTENSITE (${T_high} -> ${T_low} K) ==="
fix 1 all nvt temp ${T_high} ${T_low} ${tdamp}
run 50000

print "=== STEP 3: EQUILIBRATING AT ${T_low} K ==="
unfix 1
fix 1 all nvt temp ${T_low} ${T_low} ${tdamp}
run 20000

# Update Reference Length
run 0
variable Lz_ref equal c_zmax_comp-c_zmin_comp
print "Reference Length (Lz_ref): ${Lz_ref}"

# ============================================
# 4. COMPRESSION (Deformation)
# ============================================
reset_timestep 0

# Define moving walls with variable positions
variable z_hi_start equal c_zmax_comp
variable z_lo_start equal c_zmin_comp
variable total_disp equal v_Lz_ref*v_strain_max

# Ramping variables
variable start_step equal step
variable ramp equal "(step - v_start_step) / v_load_steps"
variable ramp_safe equal "step > (v_start_step + v_load_steps) ? 1.0 : v_ramp"

# Wall positions move symmetrically inward
variable pos_hi equal "v_z_hi_start - (v_total_disp * 0.5 * v_ramp_safe)"
variable pos_lo equal "v_z_lo_start + (v_total_disp * 0.5 * v_ramp_safe)"

# Apply harmonic walls
fix wall_hi all wall/harmonic zhi v_pos_hi 2000.0 0.0 2.5 units box
fix wall_lo all wall/harmonic zlo v_pos_lo 2000.0 0.0 2.5 units box

# Output
fix data_out all print 500 &
    "$(step) $(temp) $(c_T_core) $(v_current_Lz) $(v_true_strain) $(v_stress_GPa) $(v_frac_mart)" &
    file ${output_dir}/stress_strain.txt screen no &
    title "# Step Temp T_Core Lz Strain Stress_GPa Martensite_Frac"

dump 1 all custom 2000 ${output_dir}/deform_*.dump id type x y z c_csym
dump_modify 1 sort id element Ni Ti

print "=== STEP 4: COMPRESSION START ==="
run ${load_steps}

# ============================================
# 5. UNLOADING & RECOVERY
# ============================================
print "=== STEP 5: UNLOADING ==="
unfix wall_hi
unfix wall_lo
run 10000

variable Lz_unloaded equal c_zmax_comp-c_zmin_comp
variable residual_strain equal "(v_Lz_0 - v_Lz_unloaded)/v_Lz_0"
print "Residual Strain: ${residual_strain}"

print "=== STEP 6: HEATING (SHAPE MEMORY RECOVERY) ==="
unfix 1
fix 1 all nvt temp ${T_low} ${T_high} ${tdamp}
run 50000

unfix 1
fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}
run 10000

variable Lz_final equal c_zmax_comp-c_zmin_comp
variable recovery equal "(v_Lz_final - v_Lz_unloaded) / (v_Lz_0 - v_Lz_unloaded + 1.0e-6)"
print "Final Recovery Ratio: ${recovery}"

print "SIMULATION COMPLETE."