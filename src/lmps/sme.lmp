# filepath: /home/rimuru/workspace/src/lmps/sme.lmp
# GOAL: NiTi Nanoparticle SME (Cool -> Load -> Unload -> Heat)
# REVISION: v1 (Restart-Proof Reference States)

clear
units       metal
dimension   3
# [PHYSICS] 's' is safer for drift, but we need room for walls.
# We will center the particle initially to ensure 's' works well.
boundary    s s s
atom_style  atomic

# --- VARIABLES & DEFAULTS (LAMMPS 2Aug2023-compatible; no is_defined()) ---
# Prefer environment variables (uppercase), fall back to lowercase, then hard defaults.

variable input_data getenv INPUT_DATA
if "${input_data} == 'NULL' || ${input_data} == ''" then "variable input_data getenv input_data"
if "${input_data} == 'NULL' || ${input_data} == ''" then "variable input_data string 'minimized.data'"

variable restart_file getenv RESTART_FILE
if "${restart_file} == 'NULL' || ${restart_file} == ''" then "variable restart_file getenv restart_file"
if "${restart_file} == 'NULL' || ${restart_file} == ''" then "variable restart_file string 'none'"

variable output_dir getenv OUTPUT_DIR
if "${output_dir} == 'NULL' || ${output_dir} == ''" then "variable output_dir getenv output_dir"
if "${output_dir} == 'NULL' || ${output_dir} == ''" then "variable output_dir string 'sme_output'"

variable restart_dir getenv RESTART_DIR
if "${restart_dir} == 'NULL' || ${restart_dir} == ''" then "variable restart_dir getenv restart_dir"
if "${restart_dir} == 'NULL' || ${restart_dir} == ''" then "variable restart_dir string 'restarts'"

variable pot_lib getenv POT_LIB
if "${pot_lib} == 'NULL' || ${pot_lib} == ''" then "variable pot_lib getenv pot_lib"
if "${pot_lib} == 'NULL' || ${pot_lib} == ''" then "variable pot_lib string 'library.meam'"

variable pot_file getenv POT_FILE
if "${pot_file} == 'NULL' || ${pot_file} == ''" then "variable pot_file getenv pot_file"
if "${pot_file} == 'NULL' || ${pot_file} == ''" then "variable pot_file string 'NiTi.meam'"

variable seed getenv SEED
if "${seed} == 'NULL' || ${seed} == ''" then "variable seed getenv seed"
if "${seed} == 'NULL' || ${seed} == ''" then "variable seed string '12345'"

# restart cadence (was used but never defined)
variable restart_every equal 10000

shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# --- INITIALIZATION ---
if "${restart_file} == none" then "read_data ${input_data}"
if "${restart_file} != none" then "read_restart ${restart_file}"

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin
neigh_modify delay 10 every 1 check yes

comm_style tiled
fix bal all balance 5000 1.05 rcb

timestep    0.002

# --- PROTOCOL PARAMETERS ---
variable T_low      equal 200.0
variable T_high     equal 500.0
variable tdamp      equal 100.0*dt

# Mechanical Loading (Compression)
variable strain_max equal 0.10      # 10% Strain
variable load_time  equal 2000.0    # ps
variable load_steps equal round(v_load_time/dt)

# Stage Durations (Steps)
variable cool_steps   equal 50000
variable hold_low     equal 30000
variable unload_steps equal 20000
variable heat_steps   equal 50000
variable hold_high    equal 20000

# Absolute End Steps
variable end0 equal ${cool_steps}
variable end1 equal ${end0}+${hold_low}
variable end2 equal ${end1}+${load_steps}
variable end3 equal ${end2}+${unload_steps}
variable end4 equal ${end3}+${heat_steps}
variable end5 equal ${end4}+${hold_high}

# --- PERSISTENCE LOGIC (Restart-proof reference state) ---
variable param_file string "${output_dir}/ref_params.lmp"

# Default values (overwritten if ref_params.lmp contains saved values)
variable Lz_ref equal 0.0
variable z_hi0  equal 0.0
variable z_lo0  equal 0.0

# Make sure the file exists; empty include is OK and avoids is_file()
shell touch "${param_file}"
include ${param_file}

# --- COMPUTES ---
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
variable R_eff equal sqrt(c_r2max)
variable V_eff equal (4.0/3.0)*PI*(v_R_eff^3)

# Core Identification
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core dynamic all var core_mask every 1000

compute T_core core temp

# Stress & Phase
compute pe_atom all pe/atom
compute csym all centro/atom bcc
compute ack  all ackland/atom
compute st   all stress/atom NULL

compute Szz all reduce sum c_st[3]
# Stress in GPa
variable sigma_zz_GPa equal -(c_Szz/(v_V_eff+1.0e-12))*1.0e-4

# Shape Metrics
compute gyr all gyration
variable Rg    equal c_gyr
variable Rg_zz equal c_gyr[3] # Elongation along loading axis

# Phase Fraction (Austenite Proxy)
variable is_austenite atom "c_ack == 3"
compute n_aus core reduce sum v_is_austenite
variable n_core   equal "count(core)"
variable frac_aus equal "c_n_aus/(v_n_core+1.0e-6)"

# Geometry & Strain
compute zmin all reduce min z
compute zmax all reduce max z
variable Lz equal (c_zmax - c_zmin)

# Strain Calculation (Safe: Uses Lz_ref which is either 0.0 or loaded from file)
# If Lz_ref is 0 (fresh run before Stage 2), strain is 0.
variable strain equal "(v_Lz_ref > 0) * (v_Lz - v_Lz_ref)/(v_Lz_ref+1.0e-12)"

# --- EXECUTION ---

# Init Velocities (Only if fresh start)
if "$(step) == 0" then "velocity all create ${T_high} 48274 mom yes rot yes dist gaussian"
fix mom all momentum 100 linear 1 1 1 angular

# Outputs
restart ${restart_every} ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

thermo 1000
thermo_style custom step temp c_T_core v_sigma_zz_GPa v_frac_aus v_Rg v_strain

fix out all print 500 &
"$(step) $(time) $(temp) $(c_T_core) $(v_Lz) $(v_strain) $(v_sigma_zz_GPa) $(v_frac_aus) $(v_Rg) $(v_Rg_zz)" &
file ${output_dir}/sme_scalar.txt append yes screen no

dump 1 all custom 5000 ${output_dir}/dump.sme.*.gz id type x y z c_csym c_ack c_st[3]
dump_modify 1 sort id element Ni Ti

print ">>> STARTING SME PROTOCOL..."

# --- STAGE 0: COOLING ---
if "$(step) < ${end0}" then &
  "print '>>> STAGE 0: Cooling to ${T_low} K'" &
  "fix nvt all nvt temp ${T_high} ${T_low} ${tdamp}" &
  "run ${end0} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage0_end"

# --- STAGE 1: HOLD LOW ---
if "$(step) < ${end1}" then &
  "print '>>> STAGE 1: Holding at ${T_low} K'" &
  "fix nvt all nvt temp ${T_low} ${T_low} ${tdamp}" &
  "run ${end1} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage1_end"

# --- CAPTURE REFERENCE STATE (CRITICAL) ---
# We calculate and SAVE the reference state so restarts know where 'zero' strain is.
# We only do this if we just finished Stage 1 (approximately).
if "$(step) == ${end1}" then &
  "run 0" &
  "variable current_Lz equal v_Lz" &
  "variable current_zhi equal c_zmax" &
  "variable current_zlo equal c_zmin" &
  "print '# Reference Parameters for SME Loading' file ${param_file}" &
  "print 'variable Lz_ref equal ${current_Lz}' append ${param_file}" &
  "print 'variable z_hi0  equal ${current_zhi}' append ${param_file}" &
  "print 'variable z_lo0  equal ${current_zlo}' append ${param_file}" &
  "print '>>> REFERENCE STATE SAVED to ${param_file}'" &
  "include ${param_file}" 

# --- STAGE 2: LOADING (COMPRESSION) ---
if "$(step) < ${end2}" then &
  "print '>>> STAGE 2: Loading (Compression)'" &
  "fix nvt all nvt temp ${T_low} ${T_low} ${tdamp}" &
  "variable start_step equal ${end1}" &
  "variable ramp equal (step - v_start_step)/${load_steps}" &
  "variable ramp_safe equal (step > (v_start_step + ${load_steps})) ? 1.0 : v_ramp" &
  "variable pos_hi equal v_z_hi0 - (${Lz_ref}*${strain_max}*0.5*v_ramp_safe)" &
  "variable pos_lo equal v_z_lo0 + (${Lz_ref}*${strain_max}*0.5*v_ramp_safe)" &
  "fix wall_hi all wall/harmonic zhi v_pos_hi 100.0 0.0 2.5 units box" &
  "fix wall_lo all wall/harmonic zlo v_pos_lo 100.0 0.0 2.5 units box" &
  "run ${end2} upto" &
  "unfix wall_hi" &
  "unfix wall_lo" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage2_end"

# --- STAGE 3: UNLOADING ---
if "$(step) < ${end3}" then &
  "print '>>> STAGE 3: Unloading (Relaxation)'" &
  "fix nvt all nvt temp ${T_low} ${T_low} ${tdamp}" &
  "run ${end3} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage3_end"

# --- STAGE 4: HEATING (RECOVERY) ---
if "$(step) < ${end4}" then &
  "print '>>> STAGE 4: Heating to ${T_high} K (Shape Recovery)'" &
  "fix nvt all nvt temp ${T_low} ${T_high} ${tdamp}" &
  "run ${end4} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage4_end"

# --- STAGE 5: FINAL HOLD ---
if "$(step) < ${end5}" then &
  "print '>>> STAGE 5: Final Hold at ${T_high} K'" &
  "fix nvt all nvt temp ${T_high} ${T_high} ${tdamp}" &
  "run ${end5} upto" &
  "unfix nvt" &
  "write_restart ${restart_dir}/restart.stage5_end"

print "SME CYCLE COMPLETE."