# filepath: /home/rimuru/workspace/src/lmps/thermal_cycle.lmp
# GOAL: Journal-Quality Thermal Hysteresis (Linear Execution / No Logic Crashes)
# REVISION: v6 (Removed IFs, implemented 'run upto')

clear
units       metal
dimension   3
boundary    s s s   
atom_style  atomic

# ==========================================================================
# 1. ENVIRONMENT & VARIABLES
# ==========================================================================
variable input_data    getenv INPUT_DATA
variable output_dir    getenv OUTPUT_DIR
variable restart_dir   getenv RESTART_DIR
variable pot_lib       getenv POT_LIB
variable pot_file      getenv POT_FILE
variable seed          getenv SEED

# Create directories (Shell command is safe here)
shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# --- Physics Parameters ---
variable T_low     equal 200.0
variable T_high    equal 500.0
variable T_rate    equal 0.1      # K/ps
variable tdamp     equal 0.1      # 100*dt 

# --- Timing ---
timestep     0.002
variable     delta_T     equal (v_T_high-v_T_low)
# Calculate steps needed for ramp
variable     run_ramp    equal round(v_delta_T/v_T_rate/dt)
variable     run_hold    equal 50000

# --- Milestone Steps (Absolute Time) ---
# We define the EXACT step number where each stage should end.
variable     end_stage0  equal v_run_hold
variable     end_stage1  equal v_end_stage0+v_run_ramp
variable     end_stage2  equal v_end_stage1+v_run_hold
variable     end_stage3  equal v_end_stage2+v_run_ramp
variable     end_stage4  equal v_end_stage3+v_run_hold

# ==========================================================================
# 2. SETUP (The Crash-Proof Start)
# ==========================================================================
# CRITICAL FIX: Instead of checking "if restart == none", we let the 
# shell script determine the start command. 
# PASS "read_data ..." OR "read_restart ..." as the environment variable 'START_CMD'
# If you cannot change the shell script, uncomment the manual fallback below.

variable start_cmd getenv START_CMD
${start_cmd} 

# --- Fallback (If you strictly need the old variable logic without crashing) ---
# To use this, comment out the ${start_cmd} line above.
# variable restart_file getenv RESTART_FILE
# if "${restart_file} == none" then "read_data ${input_data}" else "read_restart ${restart_file}"

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin
neigh_modify delay 10 every 1 check yes

# Load Balancing
comm_style tiled
fix bal all balance 5000 1.05 rcb

# ==========================================================================
# 3. COMPUTATIONS (Optimized)
# ==========================================================================
# --- A. Time & Cost ---
variable t_elapsed internal elapsed
variable cpu_hours equal v_t_elapsed/3600.0

# --- B. Core vs Surface ---
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
variable rcut_sq equal 0.64*c_r2max
variable core_mask   atom "v_rsq < v_rcut_sq"
variable surface_mask atom "v_rsq >= v_rcut_sq"

group core    dynamic all var core_mask    every 5000
group surface dynamic all var surface_mask every 5000

# --- C. Phase Transformation Metrics ---
compute T_core core temp
compute pe_all all pe/atom
compute ack    all ackland/atom

# Phase Fraction (Austenite = BCC(3))
variable is_aus atom "c_ack == 3"
compute n_aus core reduce sum v_is_aus
variable n_core equal count(core)
variable frac_aus equal "c_n_aus / (v_n_core + 1.0e-6)"

# --- D. Stress & Enthalpy ---
compute st all stress/atom NULL
variable Vol_total equal (4.0/3.0)*PI*(c_r2max^1.5)
compute Szz all reduce sum c_st[3]
variable SigmaZZ_GPa equal -(c_Szz/v_Vol_total)*1.0e-4

compute H_all all reduce sum c_pe_all
# Note: For H, we usually neglect KE in solids at constant T, 
# but (PE+KE) is safer if T changes. Adding KE:
compute ke_all all ke/atom
compute H_total_compute all reduce sum c_pe_all c_ke_all
variable H_total_eV equal c_H_total_compute[1]+c_H_total_compute[2]

# --- E. Displacement ---
compute disp all displace/atom
variable disp_mag atom sqrt(c_disp[1]^2+c_disp[2]^2+c_disp[3]^2)
compute disp_rms all reduce ave v_disp_mag

# ==========================================================================
# 4. OUTPUTS
# ==========================================================================
thermo 1000
thermo_style custom step v_cpu_hours temp c_T_core v_frac_aus v_SigmaZZ_GPa

fix data_out all print 1000 &
"$(step) $(v_cpu_hours) $(temp) $(c_T_core) $(v_H_total_eV) $(v_SigmaZZ_GPa) $(v_frac_aus) $(c_disp_rms)" &
file ${output_dir}/hysteresis_full.txt append yes screen no &
title "# Step CPU_Hrs T_Global T_Core H_Total(eV) SigmaZZ(GPa) Frac_Aus Disp_RMS(A)"

# Note: We delay the dump slightly to avoid overwriting on restart
dump 1 all custom 5000 ${output_dir}/dump.cycle.*.gz &
    id type x y z c_pe_all c_ack c_st[1] c_st[2] c_st[3] c_disp[1] c_disp[2] c_disp[3]
dump_modify 1 sort id element Ni Ti

restart 10000 ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

# ==========================================================================
# 5. EXECUTION FLOW (Linear & Robust)
# ==========================================================================

# Initialize velocities only if step is 0 (First Run)
# This is safe because 'velocity' is forbidden after a restart anyway unless 'create' is used.
# But we can't wrap it in IF. 
# SOLUTION: We assume input_data has no velocities, and restart does.
# If starting from data file, we act:
velocity all create ${T_high} ${seed} mom yes rot yes dist gaussian

fix mom all momentum 100 linear 1 1 1 angular

print ">>> STARTING THERMAL CYCLE"

# --- STAGE 0: EQUILIBRATE (500K) ---
# Target: 50,000 steps
print ">>> STAGE 0: Equilibrate Austenite"
fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}
run ${end_stage0} upto
unfix 1
write_restart ${restart_dir}/restart.stage0_end

# --- STAGE 1: COOLING (500K -> 200K) ---
# Target: 50k -> 200k steps (approx)
print ">>> STAGE 1: Cooling (A->M)"
fix 1 all nvt temp ${T_high} ${T_low} ${tdamp}
run ${end_stage1} upto
unfix 1
write_restart ${restart_dir}/restart.stage1_end

# --- STAGE 2: HOLD LOW (200K) ---
print ">>> STAGE 2: Relax Martensite"
fix 1 all nvt temp ${T_low} ${T_low} ${tdamp}
run ${end_stage2} upto
unfix 1
write_restart ${restart_dir}/restart.stage2_end

# --- STAGE 3: HEATING (200K -> 500K) ---
print ">>> STAGE 3: Heating (M->A)"
fix 1 all nvt temp ${T_low} ${T_high} ${tdamp}
run ${end_stage3} upto
unfix 1
write_restart ${restart_dir}/restart.stage3_end

# --- STAGE 4: FINAL RECOVERY (500K) ---
print ">>> STAGE 4: Final Recovery"
fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}
run ${end_stage4} upto
unfix 1
write_restart ${restart_dir}/restart.stage4_end

print ">>> SIMULATION COMPLETE. CPU HOURS: $(v_cpu_hours)"