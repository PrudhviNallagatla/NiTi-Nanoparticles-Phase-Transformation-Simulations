# filepath: /home/rimuru/workspace/src/lmps/thermal_cycle.lmp
# GOAL: Robust NiTi Nanoparticle Thermal Hysteresis (Optimized)
# AUTHOR: LAMMPS Genie
# REVISION: v4 (Added T_core compute + Drift Safety)

clear
units       metal
dimension   3
# [SAFETY] Use 's' (shrink-wrap) to prevent atoms drift-loss in vacuum
boundary    s s s   
atom_style  atomic

# --- VARIABLES & DEFAULTS ---
if "$(is_defined(input_data)) == 0"     then "variable input_data string 'minimized.data'"
if "$(is_defined(restart_file)) == 0"   then "variable restart_file string 'none'"
if "$(is_defined(output_dir)) == 0"     then "variable output_dir string 'hysteresis_output'"
if "$(is_defined(restart_dir)) == 0"    then "variable restart_dir string 'restarts'"
if "$(is_defined(pot_lib)) == 0"        then "variable pot_lib string 'library.meam'"
if "$(is_defined(pot_file)) == 0"       then "variable pot_file string 'NiTi.meam'"

shell mkdir -p "${output_dir}"
shell mkdir -p "${restart_dir}"

# ==========================================================================
# 1. INITIALIZATION
# ==========================================================================
if "${restart_file} == none" then "read_data ${input_data}"
if "${restart_file} != none" then "read_restart ${restart_file}"

# [CRITICAL] Re-specify potential after restart
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# Masses (Safety fallback)
mass 1 58.6934 # Ni
mass 2 47.867  # Ti

neighbor    2.0 bin
neigh_modify delay 10 every 1 check yes

# Load Balancing (Dynamic RCB for clustering)
comm_style tiled
fix bal all balance 5000 1.05 rcb

# ==========================================================================
# 2. PHYSICS & SETTINGS
# ==========================================================================
timestep    0.002

variable    T_low   equal 200.0
variable    T_high  equal 500.0
variable    T_rate  equal 0.1      # K/ps (Fast but standard for MD)
variable    tdamp   equal 100.0*dt 

# Duration Math
variable    delta_T     equal (v_T_high-v_T_low)
variable    run_ramp    equal round(v_delta_T/v_T_rate/dt)
variable    run_hold    equal 50000

# Step Targets (Absolute steps for reliable restarts)
variable    end_stage0  equal ${run_hold}
variable    end_stage1  equal ${end_stage0}+${run_ramp}
variable    end_stage2  equal ${end_stage1}+${run_hold}
variable    end_stage3  equal ${end_stage2}+${run_ramp}
variable    end_stage4  equal ${end_stage3}+${run_hold}

# Velocity Init (Only if fresh start)
if "$(step) == 0" then &
   "velocity all create ${T_high} 12345 mom yes rot yes dist gaussian"

variable stage_id equal -1

# ==========================================================================
# 3. ADVANCED COMPUTATIONS
# ==========================================================================
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

# --- Core/Shell Identification ---
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
variable rcut_sq equal 0.64*c_r2max
variable core_mask   atom "v_rsq < v_rcut_sq"
variable surface_mask atom "v_rsq >= v_rcut_sq"

# Dynamic groups (Update occasionally to save CPU)
group core   dynamic all var core_mask  every 1000
group surface dynamic all var surface_mask every 1000

# [FIXED BUG] Defined the missing compute!
compute T_core core temp

# --- Phase & Structure ---
compute pe_all all pe/atom
compute csym all centro/atom bcc
compute ack all ackland/atom

# --- Shape Memory Effect (SME) Metrics ---
compute gyr all gyration
variable Rg    equal c_gyr       # Total Radius of Gyration
variable Rg_xx equal c_gyr[1]
variable Rg_yy equal c_gyr[2]
variable Rg_zz equal c_gyr[3]

# --- Virial Stress (Effective) ---
compute st all stress/atom NULL
compute Szz all reduce sum c_st[3]
variable R_eff equal sqrt(c_r2max)
variable V_eff equal (4.0/3.0)*PI*(v_R_eff^3)
variable sigma_zz_bar equal -(c_Szz/(v_V_eff+1.0e-12))
variable sigma_zz_GPa equal v_sigma_zz_bar*1.0e-4

# --- Phase Fraction (BCC/B2 Tracking) ---
# Ackland: 3 = BCC. If it's not 3, it's likely transformed (B19'/Amorphous)
variable is_austenite atom "c_ack == 3"
compute n_aus core reduce sum v_is_austenite
variable n_core equal "count(core)"
variable frac_aus equal "c_n_aus / (v_n_core + 1.0e-6)"

# ==========================================================================
# 4. OUTPUTS
# ==========================================================================
variable sim_ps equal time

# Restart Strategy
restart 10000 ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

# Text Log
fix data_out all print 1000 &
    "$(v_stage_id) $(step) $(v_sim_ps) $(temp) $(c_T_core) $(epair) $(v_sigma_zz_GPa) $(v_frac_aus) $(v_Rg) $(v_Rg_xx) $(v_Rg_yy) $(v_Rg_zz)" &
    file ${output_dir}/hysteresis.txt append yes screen no &
    title "# stage_id step sim_ps T_global T_core E_pair sigmaZZ_GPa fracAUS Rg Rg_xx Rg_yy Rg_zz"

# Console Log
thermo 1000
thermo_style custom step temp c_T_core epair v_sigma_zz_GPa v_frac_aus v_Rg

# Dump Files (Compressed)
dump 1 all custom 5000 ${output_dir}/dump.cycle.*.gz id type x y z c_csym c_ack c_pe_all
dump_modify 1 sort id element Ni Ti

# ==========================================================================
# 5. EXECUTION LOOP
# ==========================================================================

# [CRITICAL] Zero Momentum Check
# Prevents the "Flying Ice Cube" artifact in vacuum MD
fix mom all momentum 100 linear 1 1 1 angular

print " "
print ">>> SIMULATION PLAN"
print "    Cooling Rate: ${T_rate} K/ps"
print "    Run Ramp:     ${run_ramp} steps"
print " "

# --- STAGE 0: HOLD HIGH (Equilibrate Austenite) ---
if "$(step) < ${end_stage0}" then &
   "variable stage_id equal 0" &
   "print '>>> STAGE 0: Equilibrate at ${T_high} K'" &
   "fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}" &
   "run ${end_stage0} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage0_end"

# --- STAGE 1: COOLING (Forward Transformation A -> M) ---
if "$(step) < ${end_stage1}" then &
   "variable stage_id equal 1" &
   "print '>>> STAGE 1: Cool ${T_high} -> ${T_low} K'" &
   "fix 1 all nvt temp ${T_high} ${T_low} ${tdamp}" &
   "run ${end_stage1} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage1_end"

# --- STAGE 2: HOLD LOW (Relax Martensite) ---
if "$(step) < ${end_stage2}" then &
   "variable stage_id equal 2" &
   "print '>>> STAGE 2: Hold at ${T_low} K'" &
   "fix 1 all nvt temp ${T_low} ${T_low} ${tdamp}" &
   "run ${end_stage2} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage2_end"

# --- STAGE 3: HEATING (Reverse Transformation M -> A) ---
if "$(step) < ${end_stage3}" then &
   "variable stage_id equal 3" &
   "print '>>> STAGE 3: Heat ${T_low} -> ${T_high} K'" &
   "fix 1 all nvt temp ${T_low} ${T_high} ${tdamp}" &
   "run ${end_stage3} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage3_end"

# --- STAGE 4: HOLD HIGH (Final Recovery) ---
if "$(step) < ${end_stage4}" then &
   "variable stage_id equal 4" &
   "print '>>> STAGE 4: Hold at ${T_high} K'" &
   "fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}" &
   "run ${end_stage4} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage4_end"

print "SIMULATION COMPLETE."