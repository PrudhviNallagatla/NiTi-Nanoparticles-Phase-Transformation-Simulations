# ==========================================================================
# ROBUST NiTi NANOPARTICLES HYSTERESIS (IQ 180 VERSION)
# ==========================================================================

clear
units       metal
dimension   3
boundary    s s s   
atom_style  atomic

# --- INPUT VARIABLES (Passed from Shell) ---
# restart_file: path to file OR "none"
# input_data:   path to data file (used if restart_file is none)
# pot_lib/file: potential paths
# output_dir:   where to dump logs/images

print "=========================================================="
print " RESTART STATUS: ${restart_file}"
print "=========================================================="

# 1. INITIALIZATION LOGIC (Split for safety)
# ----------------------------------------------------------------
if "${restart_file} == none" then "read_data ${input_data}"

if "${restart_file} != none" then "read_restart ${restart_file}"

# Reset potential (Required after read_restart for many potentials like MEAM)
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# 2. SYSTEM SETTINGS
# ----------------------------------------------------------------
# Mass definition is only strictly needed if data file lacks it, 
# but good for safety.
mass 1 58.6934
mass 2 47.867

neighbor    1.0 bin
neigh_modify delay 0 every 10 check yes

# Load Balancing (Crucial for non-periodic/vacuum systems)
comm_style tiled
fix bal all balance 5000 1.05 rcb

# 3. VARIABLES & PHYSICS
# ----------------------------------------------------------------
timestep    0.002

variable    T_low   equal 200.0
variable    T_high  equal 500.0
variable    T_rate  equal 0.1      # K/ps
variable    tdamp   equal 100.0*dt # Standard Nose-Hoover damping

# Duration Math
variable    delta_T     equal (v_T_high-v_T_low)
variable    run_ramp    equal round(v_delta_T/v_T_rate/dt)
variable    run_hold    equal 50000

# Cumulative Step Targets (The key to safe restarts)
# We calculate absolute step numbers for the end of each stage.
variable    end_stage0  equal ${run_hold}
variable    end_stage1  equal ${end_stage0}+${run_ramp}
variable    end_stage2  equal ${end_stage1}+${run_hold}
variable    end_stage3  equal ${end_stage2}+${run_ramp}
variable    end_stage4  equal ${end_stage3}+${run_hold}

# 4. INITIAL VELOCITIES (Only for fresh runs)
# ----------------------------------------------------------------
# We check 'step' effectively. If step is 0, we must initialize.
# We create velocities at T_high because Stage 0 is equilibration at T_high.
if "$(step) == 0" then &
   "velocity all create ${T_high} 12345 mom yes rot yes dist gaussian"

# 5. GROUPS & COMPUTES
# ----------------------------------------------------------------
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
variable rcut_sq equal 0.64*c_r2max

variable core_mask    atom "v_rsq < v_rcut_sq"
variable surface_mask atom "v_rsq >= v_rcut_sq"

# Initial run 0 to setup groups (avoids static group errors)
fix __int all nve
run 0
unfix __int

# Update groups occasionally
group core    dynamic all var core_mask    every 1000
group surface dynamic all var surface_mask every 1000

# Diagnostics
compute pe_all all pe/atom
compute T_core core temp
compute csym all centro/atom bcc
compute msd_all all msd

# Phase Fraction (Austenite < 1.5 CSP)
variable CSP_CUTOFF equal 1.5
variable is_austenite atom "c_csym < v_CSP_CUTOFF"
compute n_aus core reduce sum v_is_austenite
variable n_core equal "count(core)"
variable frac_aus equal "c_n_aus / (v_n_core + 1.0e-6)"

# 6. OUTPUTS
# ----------------------------------------------------------------
variable cpu_hr equal cpu/3600.0
variable sim_ps equal time

# Restart Strategy:
# 1. Rolling restart (safety against crash)
variable restart_every equal 10000
restart ${restart_every} ${restart_dir}/restart.rolling.1 ${restart_dir}/restart.rolling.2

# 2. Output Files
fix data_out all print 1000 &
    "${STAGE} $(step) $(v_sim_ps) $(temp) $(c_T_core) $(epair) $(press) $(vol) $(v_frac_aus) $(v_cpu_hr)" &
    file ${output_dir}/hysteresis.txt append yes screen no &
    title "# STAGE step sim_ps T_global T_core E_pair Press Vol fracAUS cpu_hr"

thermo 1000
thermo_style custom step temp c_T_core epair press v_frac_aus v_cpu_hr

# Dump (Snapshot)
dump 1 all custom 5000 ${output_dir}/dump.cycle.* id type x y z c_csym c_pe_all
dump_modify 1 sort id element Ni Ti

# ==========================================================================
# 7. THERMAL PROTOCOL EXECUTION
# ==========================================================================
# Fix Momentum: Removes net translation/rotation every 100 steps.
# Essential for vacuum nanoparticles to prevent "flying ice cube" artifact.
fix mom all momentum 100 linear 1 1 1 angular

print " "
print ">>> SIMULATION PLAN (Step Targets):"
print "    Stage 0 (Hold High): Ends at ${end_stage0}"
print "    Stage 1 (Cooling):   Ends at ${end_stage1}"
print "    Stage 2 (Hold Low):  Ends at ${end_stage2}"
print "    Stage 3 (Heating):   Ends at ${end_stage3}"
print "    Stage 4 (Hold High): Ends at ${end_stage4}"
print " "

# --- STAGE 0: EQUILIBRATION (Austenite) ---
if "$(step) < ${end_stage0}" then &
   "variable STAGE string stage0_hold" &
   "print '>>> STARTING STAGE 0: Equilibrate at ${T_high} K'" &
   "fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}" &
   "run ${end_stage0} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage0_end"

# --- STAGE 1: COOLING (Austenite -> Martensite) ---
if "$(step) < ${end_stage1}" then &
   "variable STAGE string stage1_cool" &
   "print '>>> STARTING STAGE 1: Cool ${T_high} -> ${T_low} K'" &
   "fix 1 all nvt temp ${T_high} ${T_low} ${tdamp}" &
   "run ${end_stage1} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage1_end"

# --- STAGE 2: HOLD LOW (Relax Martensite) ---
if "$(step) < ${end_stage2}" then &
   "variable STAGE string stage2_hold" &
   "print '>>> STARTING STAGE 2: Hold at ${T_low} K'" &
   "fix 1 all nvt temp ${T_low} ${T_low} ${tdamp}" &
   "run ${end_stage2} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage2_end"

# --- STAGE 3: HEATING (Martensite -> Austenite) ---
if "$(step) < ${end_stage3}" then &
   "variable STAGE string stage3_heat" &
   "print '>>> STARTING STAGE 3: Heat ${T_low} -> ${T_high} K'" &
   "fix 1 all nvt temp ${T_low} ${T_high} ${tdamp}" &
   "run ${end_stage3} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage3_end"

# --- STAGE 4: HOLD HIGH (Final Recovery) ---
if "$(step) < ${end_stage4}" then &
   "variable STAGE string stage4_hold" &
   "print '>>> STARTING STAGE 4: Hold at ${T_high} K'" &
   "fix 1 all nvt temp ${T_high} ${T_high} ${tdamp}" &
   "run ${end_stage4} upto" &
   "unfix 1" &
   "write_restart ${output_dir}/restart.stage4_end"

print "SIMULATION COMPLETE."