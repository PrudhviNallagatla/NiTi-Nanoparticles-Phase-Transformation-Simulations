# ====================================================================
#  PUBLICATION-GRADE NANOPARTICLE MINIMIZER (v9.0)
#  Algorithm: SD -> MD (Anneal) -> FIRE (Descent) -> CG (Polish)
#  Author: LAMMPS Genie
# ====================================================================

# --- 1. INITIALIZATION ---
clear
units           metal
dimension       3
boundary        s s s   
atom_style      atomic

# --- 2. ENVIRONMENT VARIABLES ---
variable structure_file getenv STRUCTURE_FILE
variable output_dir     getenv OUTPUT_DIR
variable pot_lib        getenv POT_LIB
variable pot_file       getenv POT_FILE

# --- 3. JOURNAL-GRADE TOLERANCES ---
# FTOL = 1.0e-6 is the "Golden Standard" for publication.
variable ETOL       equal 0.0       
variable FTOL       equal 1.0e-6    
variable MAX_ITER   equal 100000    
variable MAX_EVAL   equal 1000000   

shell mkdir -p "${output_dir}"

# --- 4. SYSTEM SETUP ---
read_data   ${structure_file}

# Load Balancing (Crucial for large, vacuum-heavy simulations)
comm_style tiled
fix bal all balance 1000 1.1 rcb

# POTENTIAL DEFINITION
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# NEIGHBOR LIST OPTIMIZATION
neighbor    2.0 bin 
neigh_modify delay 5 every 1 check yes one 10000

# --- 5. COMPUTES FOR ANALYSIS ---
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

# --- 6. THERMO OUTPUT ---
thermo      100
thermo_style custom step temp pe fmax fnorm cpu

# ====================================================================
#  STAGE 1: DE-OVERLAP (Steepest Descent)
# ====================================================================
# Purpose: Soft push to separate overlapping atoms.
# Prevents "Lost Atom" errors in later stages.
print " "
print ">>> [STAGE 1] Steepest Descent: Safety Clearance..."

min_style sd
minimize 1.0e-4 1.0e-2 500 5000

# ====================================================================
#  STAGE 2: THERMAL ANNEALING (MD)
# ====================================================================
# Purpose: NVE/Limit run to allow surface reconstruction.
# Minimizers cannot cross energy barriers; MD can.

print " "
print ">>> [STAGE 2] Thermal Anneal: Surface Reconstruction..."

reset_timestep 0
timestep 0.002  # 2.0 fs

# Initialize tiny thermal noise (10 Kelvin) to break symmetry
velocity all create 10.0 12345 dist gaussian

# NVE/Limit safely integrates even if forces are slightly high
fix 1 all nve/limit 0.1
run 1000
unfix 1

# Kill velocity (freeze) to prepare for minimization
velocity all set 0 0 0

# ====================================================================
#  STAGE 3: INERTIAL RELAXATION (FIRE) - OPTIMIZED
# ====================================================================
print " "
print ">>> [STAGE 3] FIRE Minimization: Rapid Descent..."
min_style fire

# OPTIMIZATION: Stop FIRE when Fmax hits 1.0e-3 (0.001). 
# Your log shows you are already at ~0.003, so this will finish quickly.
# Don't ask FIRE for 1.0e-4 or 1.0e-6.
minimize ${ETOL} 1.0e-3 ${MAX_ITER} ${MAX_EVAL}

# ====================================================================
#  STAGE 4: FINAL CONVERGENCE (HFTN)
# ====================================================================
print " "
print ">>> [STAGE 4] HFTN Polish: Precision Convergence..."

# Switch to HFTN. It calculates the "curvature" of the well.
# It will snap to the bottom much faster than FIRE or CG.
min_style hftn 

# Now we ask for the high precision (1.0e-5 or 1.0e-6)
minimize ${ETOL} 1.0e-5 ${MAX_ITER} ${MAX_EVAL}

# ====================================================================
#  DATA DUMP & SAVE
# ====================================================================
print " "
print ">>> Minimization Complete. Saving High-Quality Data..."

write_data ${output_dir}/minimized.data
write_restart ${output_dir}/minimized.restart

# Dump final state with analysis metrics
dump 1 all custom 1 ${output_dir}/final_state.dump.gz id type x y z c_pe_atom c_csym c_coord
dump_modify 1 sort id
run 0

# ====================================================================
#  FINAL ANALYSIS (Core vs Surface)
# ====================================================================
# Calculates bulk-like core energy for accurate tabular reporting.

# 1. Center of Mass
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

# 2. Radial Distance
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
run 0 post no

# 3. Define Core (Inner 64% Volume)
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core variable core_mask

# 4. Core Energy Calculation
compute pe_core core reduce ave c_pe_atom
run 0 post no

variable final_pe_core equal c_pe_core
variable final_fmax equal fmax

print " "
print "=========================================="
print "  SCIENTIFIC REPORT (v9.0)"
print "=========================================="
print "Final Force Max:  ${final_fmax} eV/A"
print "Core PE/Atom:     ${final_pe_core} eV"
print "Atoms in System:  $(count(all))"
print "Atoms in Core:    $(count(core))"
print "=========================================="

print ">>> DONE."