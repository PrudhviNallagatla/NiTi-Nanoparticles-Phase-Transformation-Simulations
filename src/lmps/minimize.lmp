# ====================================================================
#  MULTI-STAGE ENERGY MINIMIZATION WITH SMART RESTART
#  Purpose: Relax atomic structure to find stable configuration
#  Strategy: Progressive refinement using multiple minimization methods
# ====================================================================

# --- 1. INITIALIZATION ---
clear
units           metal          # Energy: eV, Distance: Å, Time: ps
dimension       3
boundary        s s s          # Shrink-wrapped boundaries (adjusts to atoms)
atom_style      atomic

# --- 2. INPUT/OUTPUT PATHS ---
variable structure_file getenv STRUCTURE_FILE  # Initial atomic coordinates
variable output_dir     getenv OUTPUT_DIR      # Where to save results
variable pot_lib        getenv POT_LIB         # MEAM library file
variable pot_file       getenv POT_FILE        # MEAM parameter file

# --- 3. MINIMIZATION CONVERGENCE CRITERIA ---
variable ETOL       equal 0.0        # Energy tolerance (0 = ignore energy change)
variable FTOL       equal 1.0e-5     # Force tolerance: 0.01 meV/Å (tight convergence)
variable MAX_ITER   equal 50000      # Maximum minimization iterations
variable MAX_EVAL   equal 500000     # Maximum force/energy evaluations

shell mkdir -p "${output_dir}"

# ====================================================================
#  5. SMART RESTART LOGIC
#  Checks if Stage 3 checkpoint exists; if yes, resume from there
# ====================================================================

shell test -f ${output_dir}/stage3_fire.restart && echo "RESTART_EXISTS" > ${output_dir}/.resume_flag || echo "START_FRESH" > ${output_dir}/.resume_flag

variable resume_check file ${output_dir}/.resume_flag

if "${resume_check} == RESTART_EXISTS" then &
  "print '>>> MODE: Resuming from Stage 3 checkpoint...'" &
  "read_restart ${output_dir}/stage3_fire.restart" &
  "jump SELF skip_to_stage3_logic" &
else &
  "print '>>> MODE: Starting from scratch...'" &
  "read_data ${structure_file}"

# --- INTERATOMIC POTENTIAL SETUP (Ni-Ti MEAM) ---
comm_style tiled                    # Efficient MPI domain decomposition
fix bal all balance 1000 1.1 rcb    # Dynamic load balancing every 1000 steps

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti  # Ni-Ti binary system

neighbor    2.0 bin                 # Neighbor list with 2.0 Å skin distance
neigh_modify delay 5 every 1 check yes one 10000  # Update list intelligently

# --- ATOMIC-LEVEL PROPERTY CALCULATIONS ---
compute pe_atom all pe/atom         # Per-atom potential energy
compute csym    all centro/atom bcc # Centrosymmetry (defect detection)
compute coord   all coord/atom cutoff 3.5  # Coordination number

thermo      100
thermo_style custom step temp pe fmax fnorm  # Monitor key minimization metrics

# ====================================================================
#  STAGE 1: STEEPEST DESCENT - Remove severe atomic overlaps
#  Purpose: Quickly separate atoms that are too close
#  Method: Fast but low-accuracy gradient descent
# ====================================================================
print " "
print ">>> [STAGE 1] Steepest Descent..."
min_style sd
minimize 1.0e-4 1.0e-2 1000 10000  # Loose tolerances, few iterations
write_data    ${output_dir}/stage1_sd.data
write_restart ${output_dir}/stage1_sd.restart

# ====================================================================
#  STAGE 2: THERMAL ANNEALING - Escape local minima
#  Purpose: Add kinetic energy to help atoms find better positions
#  Method: Brief MD run at low temperature with velocity damping
# ====================================================================
print " "
print ">>> [STAGE 2] Thermal Anneal..."
reset_timestep 0
thermo_style custom step temp pe fmax fnorm
timestep 0.002                      # 2 fs timestep
velocity all create 10.0 12345 dist gaussian  # Initialize at 10K
fix 1 all nve/limit 0.1            # Limit max displacement to 0.1 Å/step
run 1000                            # 2 ps shake
unfix 1
velocity all set 0 0 0              # Remove kinetic energy
write_data    ${output_dir}/stage2_anneal.data
write_restart ${output_dir}/stage2_anneal.restart

# ====================================================================
#  STAGE 3: FIRE - Inertial relaxation for medium accuracy
#  Purpose: Fast convergence using adaptive momentum
#  Method: FIRE algorithm (good for rough-to-medium relaxation)
# ====================================================================
print " "
print ">>> [STAGE 3] FIRE Descent..."
min_style fire
minimize ${ETOL} 5.0e-2 ${MAX_ITER} ${MAX_EVAL}  # Ftol = 0.05 eV/Å
write_data    ${output_dir}/stage3_fire.data
write_restart ${output_dir}/stage3_fire.restart

# ====================================================================
#  CONVERGENCE CHECK - Skip Stage 4 if already converged
# ====================================================================
label skip_to_stage3_logic

# Redefine potential (required after reading restart file)
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# Check maximum force on any atom
variable cur_fmax equal fmax
print " "
print ">>> CURRENT FORCE MAX: ${cur_fmax} eV/A"

# Decision: If Fmax < 0.05 eV/Å, structure is acceptable
if "${cur_fmax} < 0.05" then &
  "print '>>> STATUS: Converged! Skipping Stage 4.'" &
  "jump SELF save_data" &
else &
  "print '>>> STATUS: Force still high. Proceeding to Stage 4 Polish.'"

# ====================================================================
#  STAGE 4: CONJUGATE GRADIENT - Final high-precision polish
#  Purpose: Achieve tight force tolerance for stable structure
#  Method: CG with quadratic line search (publication-quality)
# ====================================================================
print " "
print ">>> [STAGE 4] CG Polish..."

min_style cg
min_modify line quadratic dmax 0.05  # Conservative max step size
minimize ${ETOL} ${FTOL} ${MAX_ITER} ${MAX_EVAL}  # Target: 0.01 meV/Å

write_data    ${output_dir}/stage4_cg.data
write_restart ${output_dir}/stage4_cg.restart

# ====================================================================
#  FINAL OUTPUT & ANALYSIS
# ====================================================================
label save_data

print " "
print ">>> DONE. Generating Final Report..."

# Recompute properties for final state
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

# Save final configuration
write_data      ${output_dir}/final_minimized.data
write_restart   ${output_dir}/final.restart

# Detailed dump with structural analysis
dump 1 all custom 1 ${output_dir}/final_state.dump.gz id type x y z c_pe_atom c_csym c_coord
dump_modify 1 sort id
run 0

# ====================================================================
#  SCIENTIFIC METRICS - Core energy for defect characterization
# ====================================================================
compute com all com                  # Center of mass
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2  # Distance² from COM
compute r2max all reduce max v_rsq   # Maximum r²
run 0 post no

# Define "core" as inner 80% by volume (r² < 0.64*r²_max)
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core variable core_mask
compute pe_core core reduce ave c_pe_atom  # Average core energy
run 0 post no

variable final_fmax equal fmax

print " "
print "=========================================="
print "  SCIENTIFIC REPORT  "
print "=========================================="
print "Final Force Max:  ${final_fmax} eV/A"
print "Core PE/Atom:     $(c_pe_core) eV"
print "=========================================="