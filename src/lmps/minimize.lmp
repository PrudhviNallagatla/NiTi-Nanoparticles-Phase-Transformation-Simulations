# ====================================================================
#  EMERGENCY SCRIPT v9.8 - FINAL POLISHED
# ====================================================================

# --- 1. INITIALIZATION ---
clear
units           metal
dimension       3
boundary        s s s   
atom_style      atomic

# --- 2. VARIABLES ---
variable structure_file getenv STRUCTURE_FILE
variable output_dir     getenv OUTPUT_DIR
variable pot_lib        getenv POT_LIB
variable pot_file       getenv POT_FILE

# --- 3. ADJUSTED TOLERANCES ---
variable ETOL       equal 0.0        
variable FTOL       equal 1.0e-5    
variable MAX_ITER   equal 50000     
variable MAX_EVAL   equal 500000    

shell mkdir -p "${output_dir}"

# ====================================================================
#  5. SYSTEM SETUP - MANUAL TOGGLE
# ====================================================================

# [OPTION A: RESUME] (Active)
print ">>> MODE: Resuming from Stage 3 checkpoint..."
read_restart    ${output_dir}/stage3_fire.restart
# Jump immediately to logic
jump SELF skip_to_stage3_logic

# [OPTION B: START FRESH] (Commented Out)
# print ">>> MODE: Starting from scratch..."
# read_data       ${structure_file}

# --- POTENTIAL SETUP ---
comm_style tiled
fix bal all balance 1000 1.1 rcb

pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

neighbor    2.0 bin 
neigh_modify delay 5 every 1 check yes one 10000

# THESE ARE DEFINED HERE FOR FRESH RUNS
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

thermo      100
thermo_style custom step temp pe fmax fnorm

# ====================================================================
#  STAGE 1: DE-OVERLAP (SD)
# ====================================================================
print " "
print ">>> [STAGE 1] Steepest Descent..."
min_style sd
minimize 1.0e-4 1.0e-2 1000 10000
write_data    ${output_dir}/stage1_sd.data
write_restart ${output_dir}/stage1_sd.restart

# ====================================================================
#  STAGE 2: ANNEAL (MD)
# ====================================================================
print " "
print ">>> [STAGE 2] Thermal Anneal..."
reset_timestep 0
thermo_style custom step temp pe fmax fnorm
timestep 0.002 
velocity all create 10.0 12345 dist gaussian
fix 1 all nve/limit 0.1
run 1000
unfix 1
velocity all set 0 0 0
write_data    ${output_dir}/stage2_anneal.data
write_restart ${output_dir}/stage2_anneal.restart

# ====================================================================
#  STAGE 3: INERTIAL RELAXATION (FIRE)
# ====================================================================
print " "
print ">>> [STAGE 3] FIRE Descent..."
min_style fire
minimize ${ETOL} 5.0e-2 ${MAX_ITER} ${MAX_EVAL}
write_data    ${output_dir}/stage3_fire.data
write_restart ${output_dir}/stage3_fire.restart

# ====================================================================
#  SMART LOGIC CHECKPOINT
# ====================================================================
label skip_to_stage3_logic

# 1. Re-define Potential (Required if we jumped here)
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# 2. Check Force
variable cur_fmax equal fmax
print " "
print ">>> CURRENT FORCE MAX: ${cur_fmax} eV/A"

# 3. Decision
if "${cur_fmax} < 0.05" then &
  "print '>>> STATUS: Converged! Skipping Stage 4.'" &
  "jump SELF save_data" &
else &
  "print '>>> STATUS: Force still high. Proceeding to Stage 4 Polish.'"

# ====================================================================
#  STAGE 4: CG POLISH (Only runs if needed)
# ====================================================================
print " "
print ">>> [STAGE 4] CG Polish..."

min_style cg
min_modify line quadratic dmax 0.05
minimize ${ETOL} ${FTOL} ${MAX_ITER} ${MAX_EVAL}

write_data    ${output_dir}/stage4_cg.data
write_restart ${output_dir}/stage4_cg.restart

# ====================================================================
#  FINAL DATA SAVE
# ====================================================================
label save_data

print " "
print ">>> DONE. Generating Final Report..."

# --- RE-DEFINE COMPUTES FOR DUMP ---
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

# Save Files
write_data      ${output_dir}/final_minimized.data
write_restart   ${output_dir}/final.restart

# Dump using the computes we just defined
dump 1 all custom 1 ${output_dir}/final_state.dump.gz id type x y z c_pe_atom c_csym c_coord
dump_modify 1 sort id
run 0

# ====================================================================
#  FINAL REPORT
# ====================================================================
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
run 0 post no

variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core variable core_mask
compute pe_core core reduce ave c_pe_atom
run 0 post no

variable final_fmax equal fmax

print " "
print "=========================================="
print "  SCIENTIFIC REPORT (v9.8)"
print "=========================================="
print "Final Force Max:  ${final_fmax} eV/A"
print "Core PE/Atom:     $(c_pe_core) eV"
print "=========================================="