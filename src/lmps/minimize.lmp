# ====================================================================
#  UNIVERSAL ROBUST MINIMIZATION SCRIPT (v5)
#  Goal: Minimize ANY metallic nanoparticle (NiTi, Cu, Au, etc.)
#  Author: LAMMPS Genie
# ====================================================================

# --- 1. INITIALIZATION ---
clear
units           metal
dimension       3
boundary        s s s   
atom_style      atomic

# --- 2. INPUT VARIABLES (Environment) ---
# Set these in your terminal before running:
# export STRUCTURE_FILE="my_particle.data"
# export OUTPUT_DIR="results"
# export POT_LIB="library.meam"
# export POT_FILE="NiTi.meam"
variable structure_file getenv STRUCTURE_FILE
variable output_dir     getenv OUTPUT_DIR
variable pot_lib        getenv POT_LIB
variable pot_file       getenv POT_FILE

# --- 3. UNIVERSAL TOLERANCE SETTINGS ---
# "Set it and forget it" parameters for metal potentials (MEAM/EAM)
variable ETOL       equal 0.0       # Ignore energy (focus on forces)
variable FTOL_LOOSE equal 1.0e-4    # Loose tolerance for initial stages
variable FTOL_TIGHT equal 1.0e-6    # Final "Publication Grade" tolerance
variable MAX_ITER   equal 100000    # Max iterations safety cap
variable MAX_EVAL   equal 1000000   # Max force eval safety cap

# --- 4. TIMER & OUTPUT SETUP ---
# FIXED: Use 'elapsed' instead of 'timer()' for compatibility
variable cpu_time equal elapsed
variable cpu_mins equal v_cpu_time/60.0

# Setup Output Directory
shell mkdir -p "${output_dir}"

# --- 5. SYSTEM SETUP ---
read_data   ${structure_file}

# Potential Definition (MEAM)
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# Neighbor List Optimization (Faster for static minimizations)
neighbor    2.0 bin 
neigh_modify delay 0 every 1 check yes

# Load Balancing (Crucial for large, irregular NPs)
comm_style tiled
fix bal all balance 2000 1.05 rcb

# --- 6. DEFINE COMPUTES ---
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

# --- 7. THERMO OUTPUT CONFIGURATION ---
# We add 'v_cpu_mins' to the output to track CPU time in minutes
thermo      100
thermo_style custom step temp pe fmax fnorm v_cpu_mins

# Check Initial State
run 0 post no
variable natoms equal count(all)
variable init_pe equal pe/v_natoms

print "=========================================="
print "INITIAL STATUS:"
print "Atoms:       ${natoms}"
print "Init PE/atom: ${init_pe} eV"
print "=========================================="

# Safety: Abort if physics is broken (atoms overlapping < 0.5 Angstrom)
if "${init_pe} > 100.0" then &
    "print 'CRITICAL ERROR: Massive overlaps detected. PE > 100 eV/atom.' " &
    "quit 1"

# ====================================================================
#  EXECUTION: THE 3-STAGE UNIVERSAL PROTOCOL
# ====================================================================

# >>> STAGE 1: Steepest Descent (SD)
# Purpose: Untangle high-energy overlaps. Robust but slow.
print ">>> STAGE 1: Steepest Descent (Softening)..."
min_style sd
min_modify dmax 0.1  # Limit atom movement to 0.1 Angstrom/step to prevent explosions
minimize 1.0e-4 ${FTOL_LOOSE} 1000 ${MAX_EVAL}

# >>> STAGE 2: Conjugate Gradient (CG)
# Purpose: The workhorse. Drags system to the nearest basin efficiently.
print ">>> STAGE 2: Conjugate Gradient (Main Minimization)..."
min_style cg
# Note: min_modify dmax is IGNORED by CG, so we don't need to unset it.
# We use ETOL=0.0 to ensure it keeps going until forces are low.
minimize ${ETOL} ${FTOL_LOOSE} 10000 ${MAX_EVAL}

# >>> STAGE 3: FIRE (Fast Inertial Relaxation Engine)
# Purpose: Navigate the flat/noisy bottom of the MEAM potential well.
print ">>> STAGE 3: FIRE (Final Polish)..."
min_style fire
# We tighten the tolerance here to 1.0e-6
minimize ${ETOL} ${FTOL_TIGHT} ${MAX_ITER} ${MAX_EVAL}

# ====================================================================
#  ANALYSIS & VERIFICATION
# ====================================================================

# Force updated neighbor lists and computes
run 0

# 1. Define Core (Atoms < 64% of max radius^2)
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
run 0 # Evaluate compute

variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core variable core_mask

# 2. Calculate Final Core Energy
compute pe_core core reduce ave c_pe_atom
run 0 # Evaluate compute

variable final_pe_core equal c_pe_core
variable final_fmax equal fmax
variable total_time equal v_cpu_mins

# 3. Validation Logic
print " "
print "=========================================="
print "FINAL DIAGNOSTICS"
print "=========================================="
print "Total Time:       ${total_time} minutes"
print "Final Force Max:  ${final_fmax} eV/A"
print "Core PE/atom:     ${final_pe_core} eV"

# Check Convergence
if "${final_fmax} > ${FTOL_TIGHT}" then &
    "print 'WARNING: Minimization did not reach strict tolerance.'" &
    "print 'This is common for large NPs. Check if fmax is < 1e-4.'"

# Check Physics (NiTi specific check, adjust for other metals if needed)
if "${final_pe_core} > -3.5" then &
    "print 'WARNING: Core energy is high. Structure may be amorphous.'"

# --- 8. SAVE RESULTS ---
print ">>> Saving files..."
write_data ${output_dir}/minimized.data
write_restart ${output_dir}/minimized.restart

# Dump final snapshot with analysis data
dump 1 all custom 1 ${output_dir}/minimized.dump.gz id type x y z c_pe_atom c_csym c_coord
dump_modify 1 sort id
run 0

print ">>> DONE."