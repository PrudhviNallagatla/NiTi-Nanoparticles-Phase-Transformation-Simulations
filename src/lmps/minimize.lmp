# ====================================================================
#  PUBLICATION-GRADE NANOPARTICLE MINIMIZER (v8.0)
#  Algorithm: SD (De-overlap) -> MD (Anneal) -> CG (Polish)
#  Author: LAMMPS Genie
# ====================================================================

# --- 1. INITIALIZATION ---
clear
units           metal
dimension       3
boundary        s s s   
atom_style      atomic

# --- 2. ENVIRONMENT VARIABLES (Universal Input) ---
variable structure_file getenv STRUCTURE_FILE
variable output_dir     getenv OUTPUT_DIR
variable pot_lib        getenv POT_LIB
variable pot_file       getenv POT_FILE

# --- 3. JOURNAL-GRADE TOLERANCES ---
# FTOL = 1.0e-6 is the standard expected by reviewers for "fully relaxed" structures.
# We achieve this speed by using the MD-Anneal stage first.
variable ETOL       equal 0.0       
variable FTOL       equal 1.0e-6    
variable MAX_ITER   equal 100000    
variable MAX_EVAL   equal 1000000   

# Setup Output
shell mkdir -p "${output_dir}"

# --- 4. SYSTEM SETUP (High-Performance Mode) ---
read_data   ${structure_file}

# DYNAMIC LOAD BALANCING (Critical for >10nm sizes)
# 'rcb' (Recursive Coordinate Bisection) ignores vacuum and assigns 
# atoms to processors equally.
comm_style tiled
fix bal all balance 1000 1.1 rcb

# POTENTIAL DEFINITION
pair_style  meam
pair_coeff  * * ${pot_lib} Ni Ti ${pot_file} Ni Ti

# NEIGHBOR LIST OPTIMIZATION
# 'delay 5' reduces overhead. 'one 10000' prevents crashes in dense cores.
neighbor    2.0 bin 
neigh_modify delay 5 every 1 check yes one 10000

# --- 5. COMPUTES FOR ANALYSIS ---
compute pe_atom all pe/atom
compute csym    all centro/atom bcc
compute coord   all coord/atom cutoff 3.5

# --- 6. THERMO OUTPUT ---
thermo      100
thermo_style custom step temp pe fmax fnorm cpu

# ====================================================================
#  STAGE 1: DE-OVERLAP (Safety First)
# ====================================================================
print " "
print ">>> [STAGE 1] Steepest Descent: Removing bad contacts..."

# Soft push to separate overlapping atoms without blowing up
min_style sd
minimize 1.0e-4 1.0e-2 500 5000

# ====================================================================
#  STAGE 2: THERMAL ANNEALING (The "Journal Quality" Step)
# ====================================================================
# Why? Large NPs get "jammed" in local minima. A simple minimizer cannot
# fix this. We use a short MD run (10K) to "shake" atoms into the correct lattice.

print " "
print ">>> [STAGE 2] Thermal Anneal: Shaking out local minima..."

reset_timestep 0
timestep 0.002  # 2.0 fs

# Initialize tiny thermal noise (10 Kelvin)
velocity all create 10.0 12345 dist gaussian

# Use NVE/Limit to safely integrate even if forces are still high
fix 1 all nve/limit 0.1

# Run for 2.0 ps (Enough to relax surface stress, short enough to save CPU)
run 1000

unfix 1
# Remove velocities (freeze system) for final minimization
velocity all set 0 0 0

# ====================================================================
#  STAGE 3: FINAL CONVERGENCE (High Precision)
# ====================================================================
print " "
print ">>> [STAGE 3] Final Polish: Converging to 1.0e-6 eV/A..."

min_style cg
# Switch to quadratic line search (Faster for metals near bottom of well)
min_modify line quadratic
minimize ${ETOL} ${FTOL} ${MAX_ITER} ${MAX_EVAL}

# ====================================================================
#  DATA DUMP & SAVE
# ====================================================================
print " "
print ">>> Minimization Complete. Saving High-Quality Data..."

# 1. Save Structure
write_data ${output_dir}/minimized.data

# 2. Save Restart (Crucial for Journals - Proof of reproducibility)
write_restart ${output_dir}/minimized.restart

# 3. Dump Compressed Trajectory (Last frame only)
# We dump the final state with all metrics (PE, CSP, Coord)
dump 1 all custom 1 ${output_dir}/final_state.dump.gz id type x y z c_pe_atom c_csym c_coord
dump_modify 1 sort id
run 0

# ====================================================================
#  FINAL ANALYSIS (Core vs Surface)
# ====================================================================
# This section calculates the energy of the "bulk-like" core, 
# ignoring surface effects. This is the value you report in tables.

# 1. Calculate Center of Mass
compute com all com
variable xcm equal c_com[1]
variable ycm equal c_com[2]
variable zcm equal c_com[3]

# 2. Calculate Distance from Center
variable rsq atom (x-v_xcm)^2+(y-v_ycm)^2+(z-v_zcm)^2
compute r2max all reduce max v_rsq
run 0 post no

# 3. Define Core (Inner 80% radius = 64% Volume)
variable rcut_sq equal 0.64*c_r2max
variable core_mask atom "v_rsq < v_rcut_sq"
group core variable core_mask

# 4. Calculate Core Energy
compute pe_core core reduce ave c_pe_atom
run 0 post no

variable final_pe_core equal c_pe_core
variable final_fmax equal fmax

print " "
print "=========================================="
print "  SCIENTIFIC REPORT"
print "=========================================="
print "Final Force Max:  ${final_fmax} eV/A"
print "Core PE/Atom:     ${final_pe_core} eV"
print "Atoms in System:  $(count(all))"
print "Atoms in Core:    $(count(core))"
print "=========================================="

print ">>> DONE."